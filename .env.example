# إعدادات مفتاح الذكاء الاصطناعي (Gemini AI API Key)
# يمكنك الحصول على المفتاح مجاناً من: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
PORT=3000

# إعدادات بوابة الدفع الإلكتروني مويسر (Moyasar Payment Gateway)
# احصل على المفاتيح بعد فتح حسابك في: https://moyasar.com
MOYASAR_PUBLISHABLE_KEY=pk_test_...
MOYASAR_SECRET_KEY=sk_test_...

# التخزين السحابي والحسابات (Supabase) - اختياري
# أنشئ مشروع Supabase ثم انسخ Project URL و anon public key من Settings > API.
# بدون هذه القيم يستمر التطبيق بوضع التخزين المحلي ولا تُرسل أي بيانات للخارج.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
